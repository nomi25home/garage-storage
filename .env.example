# ─────────────────────────────────────────────
# Kapaat — environment configuration
# Copy this file to .env and fill in your values.
# .env is never committed; this file is safe to commit.
# ─────────────────────────────────────────────

# Public-facing URL used to build QR code deep-links.
# Must be reachable from phones on your local network (or the internet if exposed).
# Example: http://192.168.1.10:8096  or  https://bins.example.com
BASE_URL=http://localhost:8096

# Optional: n8n webhook URL for Google Sheets sync.
# Leave blank (or remove the line) to disable all webhook calls.
N8N_WEBHOOK_URL=

# Paths inside the container — change only if you remap the Docker volume.
DB_PATH=/data/garage_inventory.db
PHOTOS_DIR=/data/photos

# Display name shown in the browser tab and API docs.
APP_TITLE=Kapaat

# Timezone (used for timestamps).
TZ=America/New_York

# [OPTIONAL] Authentik OIDC Configuration
# If AUTHENTIK_CLIENT_ID is supplied, native OIDC authentication routes will lock down the app.
# If left blank, Kapaat runs in standard single-user local household mode.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ISSUER_URL=
AUTH_SECRET_KEY=change-me-in-production

# [OPTIONAL] Set a secret passphrase to enable AES-256 on-disk encryption via SQLCipher.
# Requires pysqlcipher3-binary to be installed (included in requirements.txt).
# WARNING: If you lose this key, you lose access to your data — there is no recovery.
# Leave blank (default) to use standard unencrypted SQLite.
DB_ENCRYPTION_KEY=
